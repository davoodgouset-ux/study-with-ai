PROJECT_NAME="Study With AI"
ENVIRONMENT="development"
PORT=8000

# Database Configuration
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/study_with_ai

# Gemini API Key (Needed in Phase 12)
GEMINI_API_KEY=your_gemini_api_key_here

# Semantic embedding retrieval. Gemini is preferred when configured; the local
# Sentence Transformer is a real semantic fallback, never a random-vector one.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=3072
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_EMBEDDING_DEVICE=cpu
MIN_RETRIEVAL_SCORE=0.35

# JWT Authentication Security
SECRET_KEY=study_with_ai_super_secret_jwt_key_2026_cse_final_year_project_secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload Constraints
MAX_FILE_SIZE_MB=25

